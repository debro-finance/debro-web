# Canonical origin used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://debro.finance

# Production indexing stays disabled unless this is exactly "true" on a
# Vercel Production deployment. Previews are always non-indexable.
SITE_INDEXABLE=false

# Waitlist writes require explicit enablement. Keep unset/false until the
# legal and privacy release gates are approved.
WAITLIST_ENABLED=false

# Neon pooled connection string. Server-only: never prefix with NEXT_PUBLIC_.
DATABASE_URL=

# Optional salt used when hashing visitor IPs in the in-memory rate limiter.
RATE_LIMIT_SALT=
