{
  "name": "debro-web",
  "version": "0.1.0",
  "private": true,
  "description": "DeBro institutional prelaunch website",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:db": "vitest run tests/integration",
    "test:watch": "vitest",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "waitlist:remove": "node --env-file-if-exists=.env.local scripts/waitlist-remove.mjs",
    "waitlist:report": "node --env-file-if-exists=.env.local scripts/waitlist-report.mjs",
    "assets:generate": "node scripts/generate-brand-assets.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.1",
    "@vercel/analytics": "2.0.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.13",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
